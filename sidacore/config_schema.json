{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sidacore config, version 2",
  "type": "object",
  "additionalProperties": false,
  "required": ["config_version", "protonation_ph", "box_center_atom", "box_size_angstrom",
               "exhaustiveness", "num_modes", "seeds", "waters", "alt_conformers",
               "redock_rmsd_acceptance", "ligand_resname", "structures", "redock_nadp",
               "cross_docking_arms",
               "receptor_chain", "ions", "pocket_radius_angstrom"],
  "properties": {
    "config_version": {"const": 2},
    "protonation_ph": {"type": "number", "minimum": 0, "maximum": 14},
    "box_center_atom": {"type": "string", "pattern": "^[A-Za-z0-9]{1,3}:[A-Za-z0-9]{1,4}$"},
    "box_size_angstrom": {"type": "array", "minItems": 3, "maxItems": 3,
                          "items": {"type": "number", "exclusiveMinimum": 0}},
    "exhaustiveness": {"type": "integer", "minimum": 1},
    "num_modes": {"type": "integer", "minimum": 1},
    "seeds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer"}},
    "waters": {"enum": ["strip", "keep", "keep-within-pocket"]},
    "alt_conformers": {"enum": ["highest-occupancy", "first"]},
    "redock_rmsd_acceptance": {"type": "number", "exclusiveMinimum": 0},
    "ligand_resname": {"type": "string", "pattern": "^[A-Z0-9]{1,3}$"},
    "structures": {
      "type": "object", "additionalProperties": false,
      "required": ["benchmark_primary", "benchmark_secondary", "fad_out", "fad_in"],
      "properties": {
        "benchmark_primary": {"$ref": "#/$defs/pdb_id"},
        "benchmark_secondary": {"$ref": "#/$defs/pdb_id"},
        "fad_out": {"$ref": "#/$defs/pdb_id"},
        "fad_in": {"$ref": "#/$defs/pdb_id"}
      }
    },
    "redock_nadp": {"enum": ["keep", "strip"]},
    "receptor_chain": {"type": "string", "pattern": "^[A-Za-z0-9]{1,4}$"},
    "ions": {"enum": ["strip", "keep"]},
    "pocket_radius_angstrom": {"type": "number", "exclusiveMinimum": 0},
    "cross_docking_arms": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "structure", "nadp"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "structure": {"$ref": "#/$defs/pdb_id"},
          "nadp": {"enum": ["keep", "strip"]}
        }
      }
    }
  },
  "$defs": {"pdb_id": {"type": "string", "pattern": "^[0-9][A-Za-z0-9]{3}$"}}
}
